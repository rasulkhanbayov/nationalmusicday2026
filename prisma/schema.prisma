// Prisma schema for National Music Day 2026 ticketing
// Datasource: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────────────────────
// Seats — the 120-seat hall (12 rows × 10 seats)
// ──────────────────────────────────────────────
enum SeatStatus {
  AVAILABLE
  RESERVED // temporarily held during checkout
  SOLD
}

model Seat {
  id        String     @id @default(cuid())
  // Human label, e.g. "A5". Unique across the hall.
  label     String     @unique
  row       String // "A" .. "L"
  number    Int // 1 .. 10
  status    SeatStatus @default(AVAILABLE)

  // When RESERVED, this is the order currently holding the seat and
  // the time the hold expires. A hold past `reservedUntil` is treated
  // as free again (enforced in application logic).
  reservedUntil DateTime?
  orderId       String?
  order         Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)

  ticket Ticket?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([orderId])
}

// ──────────────────────────────────────────────
// Orders — one guest checkout = one order
// ──────────────────────────────────────────────
enum OrderStatus {
  PENDING // created, awaiting payment
  PAID // payment succeeded
  CANCELLED // payment cancelled / expired
}

model Order {
  id          String      @id @default(cuid())
  // Human-friendly reference, e.g. "NM2026-000123"
  orderNumber String      @unique
  status      OrderStatus @default(PENDING)

  // Guest contact details (no account required)
  firstName String
  lastName  String
  email     String
  phone     String?

  // Pricing is captured at purchase time so later price changes don't
  // rewrite history. Amounts are in euro cents.
  unitPriceCents Int
  quantity       Int
  totalCents     Int
  currency       String @default("eur")

  stripeSessionId       String? @unique
  stripePaymentIntentId String?

  seats   Seat[]
  tickets Ticket[]

  paidAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([email])
  @@index([status])
}

// ──────────────────────────────────────────────
// Tickets — one per seat purchased
// ──────────────────────────────────────────────
model Ticket {
  id String @id @default(cuid())
  // Public ticket id encoded in the QR code, e.g. "NM2026-000123-A5"
  ticketId String @unique

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  seatId String @unique
  seat   Seat   @relation(fields: [seatId], references: [id])

  // Check-in tracking for the door scanner
  checkedIn   Boolean   @default(false)
  checkedInAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
}

// ──────────────────────────────────────────────
// AppConfig — admin-editable key/value settings
// (e.g. TICKET_PRICE_CENTS)
// ──────────────────────────────────────────────
model AppConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
