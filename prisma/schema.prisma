// Prisma schema for the multi-event ticketing platform.
// Datasource: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────────────────────
// Event — one row per concert/show. Everything else
// (seats, orders, tickets) belongs to an Event.
// ──────────────────────────────────────────────
enum EventStatus {
  DRAFT // not visible to the public
  PUBLISHED // visible, on sale
  SOLD_OUT // visible, no seats left
  PAST // archived / finished
}

model Event {
  id       String      @id @default(cuid())
  slug     String      @unique // URL segment, e.g. "national-music-day-2026"
  status   EventStatus @default(DRAFT)

  // Display / detail content. The base fields hold the primary language (DE);
  // the *En variants hold the English translation and are shown when the
  // visitor switches to English. Empty *En falls back to the base field, so a
  // partially translated event still renders.
  name          String
  nameEn        String?
  subtitle      String?
  subtitleEn    String?
  type          String  @default("Concert") // e.g. "Classical Music Concert"
  description   String? // long-form intro paragraph(s)
  descriptionEn String?

  // Schedule
  startsAt  DateTime // event start (used for date display + schema)
  endsAt    DateTime? // optional end time
  doorsTime String? // free-text, e.g. "18:30"

  // Venue (denormalized per event)
  venueName       String
  venueNameEn     String? // English venue name, e.g. "… Hall 1 & 2"
  venueStreet     String
  venuePostalCode String
  venueCity       String
  venueCountry    String @default("Germany")
  venueCountryCode String @default("DE")

  // External ticketing. Tickets are currently sold on a third-party site, so
  // the public CTA links out here instead of using the built-in checkout.
  // When null, the event shows "Tickets coming soon" rather than a dead link.
  ticketUrl String?

  // Pricing mode. Retained for display (and for the dormant built-in checkout).
  isFree     Boolean @default(false)
  priceCents Int     @default(0) // unit price in euro cents (paid events)
  currency   String  @default("eur")

  // Total tickets on sale for this event. Checkout refuses once the number of
  // tickets already issued plus the requested quantity would exceed this.
  // Null = unlimited.
  capacity Int?

  // Legacy seat layout (seated events only). General admission ignores these.
  rows        Int @default(12) // number of rows (A, B, …)
  seatsPerRow Int @default(10)

  // Per-event order number prefix, e.g. "NM2026" → NM2026-000123.
  orderPrefix String @default("EV")
  // Monotonic counter for this event's order numbers.
  orderSeq    Int    @default(0)

  // Hero/card artwork for this event (path under /public, or an absolute URL).
  imageUrl String?

  // Full event poster (portrait). Shown as its own section on the event page
  // and opens full size in a new tab.
  posterUrl String?

  // Editorial JSON blobs (artists, program, ticket tiers) — kept flexible.
  artistsJson String? // JSON: [{ name, role, bio }]
  programJson String? // JSON: [{ part, pieces: [{ composer, title }] }]
  // JSON: [{ name, priceCents, note }] — shown when an event sells several
  // ticket types. priceCents above stays the entry-level price.
  tiersJson String?

  // Admission terms shown near the ticket picker, on the success page and in
  // the confirmation email (age limits, refund policy, what's included).
  notice   String?
  noticeEn String?

  contactEmail String?

  seats   Seat[]
  orders  Order[]
  tickets Ticket[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

// ──────────────────────────────────────────────
// Seats — belong to an Event.
// ──────────────────────────────────────────────
enum SeatStatus {
  AVAILABLE
  RESERVED // temporarily held during checkout
  SOLD
}

model Seat {
  id      String @id @default(cuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  // Human label, e.g. "A5". Unique per event.
  label  String
  row    String // "A" ..
  number Int // 1 ..
  status SeatStatus @default(AVAILABLE)

  // When RESERVED, the order holding the seat and when the hold expires.
  reservedUntil DateTime?
  orderId       String?
  order         Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)

  ticket Ticket?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventId, label])
  @@index([eventId, status])
  @@index([orderId])
}

// ──────────────────────────────────────────────
// Orders — one guest checkout = one order, for one event.
// ──────────────────────────────────────────────
enum OrderStatus {
  PENDING // created, awaiting payment (paid events only)
  PAID // payment succeeded OR free reservation confirmed
  CANCELLED // payment cancelled / expired
}

model Order {
  id          String      @id @default(cuid())
  eventId     String
  event       Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  orderNumber String      @unique
  status      OrderStatus @default(PENDING)

  // True when this order is a free reservation (no payment).
  isFree Boolean @default(false)

  // Guest contact details (no account required)
  firstName String
  lastName  String
  email     String
  phone     String?

  // Pricing captured at purchase time. For free orders these are 0.
  // unitPriceCents is the entry-level price; per-tier detail lives in
  // itemsJson: [{ tier, priceCents, quantity }].
  unitPriceCents Int
  quantity       Int
  totalCents     Int
  currency       String @default("eur")
  itemsJson      String?

  stripeSessionId       String? @unique
  stripePaymentIntentId String?

  seats   Seat[]
  tickets Ticket[]

  paidAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([eventId])
  @@index([email])
  @@index([status])
}

// ──────────────────────────────────────────────
// Tickets — one per seat purchased/reserved.
// ──────────────────────────────────────────────
model Ticket {
  id String @id @default(cuid())
  // Public ticket id encoded in the QR, e.g. "NM2026-000123-A5"
  ticketId String @unique

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // General-admission events have no seat; seated events keep the link.
  seatId String? @unique
  seat   Seat?   @relation(fields: [seatId], references: [id])

  // Which ticket type this is, e.g. "Standard Ticket" / "Support Ticket".
  tierName   String?
  priceCents Int     @default(0)

  // Check-in tracking for the door scanner.
  checkedIn   Boolean   @default(false)
  checkedInAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId])
  @@index([orderId])
}

// ──────────────────────────────────────────────
// AppConfig — global key/value settings (not per-event).
// ──────────────────────────────────────────────
model AppConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
