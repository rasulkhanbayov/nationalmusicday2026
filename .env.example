# ─────────────────────────────────────────────────────────────
# Commontone — Environment Variables
# Copy this file to `.env` and fill in real values.
# ─────────────────────────────────────────────────────────────

# Database (PostgreSQL)
# Local example: postgresql://postgres:postgres@localhost:5432/commontone
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/commontone?schema=public"

# Public site URL (no trailing slash). Used for Stripe redirects, OG tags, sitemap.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Stripe ──
# Test keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY="sk_test_xxx"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_xxx"
# From `stripe listen` or the Stripe Dashboard webhook config
STRIPE_WEBHOOK_SECRET="whsec_xxx"

# ── Resend (email) ──
# https://resend.com/api-keys
RESEND_API_KEY="re_xxx"
# Must be a verified sender domain in Resend
EMAIL_FROM="commontone <info@commontone.de>"

# ── NextAuth (admin login) ──
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Admin credentials (single admin account, credentials provider)
ADMIN_EMAIL="admin@commontone.de"
# Plain password used at the credentials login form.
ADMIN_PASSWORD="change-me-please"
